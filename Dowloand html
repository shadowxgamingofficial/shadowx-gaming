<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>ShadowX Gaming - Games & Apps</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #080b12;
      color: white;
      min-height: 100vh;
    }

    header {
      background: #111827;
      padding: 25px 15px;
      text-align: center;
      border-bottom: 2px solid #00e5ff;
    }

    header h1 {
      font-size: 32px;
      margin-bottom: 8px;
    }

    header p {
      color: #aaa;
    }

    nav {
      background: #0d111a;
      padding: 15px;
      text-align: center;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 10px;
      font-weight: bold;
    }

    nav a:hover {
      color: #00e5ff;
    }

    .container {
      max-width: 1100px;
      margin: auto;
      padding: 30px 15px;
    }

    .title {
      text-align: center;
      margin-bottom: 30px;
    }

    .title h2 {
      font-size: 28px;
      margin-bottom: 8px;
    }

    .title p {
      color: #aaa;
    }

    .section-title {
      margin: 35px 0 20px;
      font-size: 24px;
      border-left: 4px solid #00e5ff;
      padding-left: 10px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 20px;
    }

    .card {
      background: #111827;
      border: 1px solid #263244;
      border-radius: 15px;
      padding: 22px;
      text-align: center;
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: #00e5ff;
      box-shadow: 0 0 18px rgba(0, 229, 255, 0.2);
    }

    .icon {
      font-size: 55px;
      margin-bottom: 12px;
    }

    .tag {
      display: inline-block;
      background: #172033;
      color: #00e5ff;
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 12px;
      margin-bottom: 10px;
    }

    .card h3 {
      margin-bottom: 10px;
      font-size: 21px;
    }

    .card p {
      color: #aaa;
      font-size: 14px;
      min-height: 42px;
      margin-bottom: 18px;
      line-height: 1.5;
    }

    .button {
      display: inline-block;
      padding: 11px 18px;
      background: #00e5ff;
      color: #001014;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
      transition: 0.3s;
    }

    .button:hover {
      background: #00b8d4;
      transform: scale(1.05);
    }

    footer {
      margin-top: 50px;
      padding: 25px;
      text-align: center;
      background: #111827;
      color: #888;
      border-top: 1px solid #263244;
    }
  </style>
</head>

<body>

